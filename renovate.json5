{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>soulwhisper/renovate-config',
  ],
  // archived apps keep their files for reference but must not receive updates
  ignorePaths: ['**/.archived/**'],
  customManagers: [
    {
      customType: 'regex',
      description: 'Process Annotations in Docker Bake',
      managerFilePatterns: [
        '/(^|/)docker-bake\\.hcl$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\\n.+ = "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Helm chart versions pinned in flux-mirror configs',
      managerFilePatterns: [
        '/(^|/)flux-mirror\\.yaml$/',
      ],
      matchStrings: [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\n\\s+version: "(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}helm{{/if}}',
      registryUrlTemplate: '{{{registryUrl}}}',
    },
  ],
  packageRules: [
    {
      description: [
        'Release Rules for Chart Mirror Updates',
      ],
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
      commitMessageTopic: '{{depName}}',
      matchFileNames: [
        '**/flux-mirror.yaml',
      ],
      semanticCommitScope: '{{parentDir}}',
      semanticCommitType: 'release',
    },
    {
      description: 'Disable pin digests for custom-managed versions in docker-bake.hcl',
      matchManagers: [
        'custom.regex',
      ],
      matchDatasources: [
        'docker',
      ],
      pinDigests: false,
    },
    {
      description: 'Floating tags (main/latest/stable) still track digests; recreateClosed keeps automerge on for repeat digest PRs (identical branch+title triggers automergedPreviously otherwise). stable = nousresearch/hermes-agent stable channel (hermes-agent app base)',
      matchDatasources: [
        'docker',
      ],
      matchUpdateTypes: [
        'digest',
      ],
      matchCurrentValue: '/^(main|latest|stable)$/',
      enabled: true,
      recreateWhen: 'always',
    },
    {
      description: 'Block hermes-agent legacy CalVer releases: upstream NousResearch/hermes-agent switched to semver at v0.21.6, but the old v2026.x GitHub releases remain published and sort newer than 0.x under semver — without this guard renovate proposes them as upgrades (a disguised downgrade)',
      matchDatasources: [
        'github-releases',
      ],
      matchDepNames: [
        'NousResearch/hermes-agent',
      ],
      allowedVersions: '!/^v?\\d{4}\\./',
    },
    {
      description: 'hermes-agent tag bump + base digest bump ship together: retagging without the digest move would briefly publish the new tag on the old base. minimumGroupSize=2 holds a lone update until the other appears (upstream moves the stable alias ~1h after cutting the GitHub release); if one side never comes, the update waits — visible on the dependency dashboard',
      matchPackageNames: [
        'NousResearch/hermes-agent',
        'nousresearch/hermes-agent',
      ],
      groupName: 'hermes-agent',
      minimumGroupSize: 2,
    },
    {
      description: [
        'Release Rules for Application Updates',
      ],
      additionalBranchPrefix: '{{parentDir}}-',
      commitMessageExtra: '( {{currentVersion}} → {{newVersion}} )',
      commitMessageTopic: '{{depName}}',
      matchFileNames: [
        '**/docker-bake.hcl',
        '**/Dockerfile',
      ],
      semanticCommitScope: '{{parentDir}}',
      semanticCommitType: 'release',
    },
    {
      description: [
        'Allowed Alpine Version for Base Images',
      ],
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        '**/Dockerfile',
      ],
      matchPackageNames: [
        '/alpine/',
      ],
      allowedVersions: '/3\\.23/',
    },
    {
      description: [
        'Allowed Python Version for Base Images',
      ],
      matchDatasources: [
        'docker',
      ],
      matchFileNames: [
        '**/Dockerfile',
      ],
      matchPackageNames: [
        '/python/',
      ],
      allowedVersions: '/3\\.14-alpine3\\.23/',
    },
    {
      description: [
        'Open major updates directly, no dashboard approval',
      ],
      matchUpdateTypes: [
        'major',
      ],
      dependencyDashboardApproval: false,
    },
    {
      description: [
        'Auto-merge every update via PR once CI passes',
      ],
      matchPackageNames: [
        '*',
      ],
      automerge: true,
      automergeType: 'pr',
      platformAutomerge: true,
      ignoreTests: false,
    },
    {
      description: 'dsh-tavern updates need human review: the appliance is stability-pinned (core bumps can shift profile/patch semantics; eco-plugin pins are coupled to the tavern ref and deliberately untracked) — label and block automerge for anything touching the app',
      matchFileNames: [
        'apps/dsh-tavern/**',
      ],
      automerge: false,
      labels: [
        'review/required',
      ],
    },
  ],
}
